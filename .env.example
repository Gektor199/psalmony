# Local development defaults. Choose a strong password for deployment.
POSTGRES_PASSWORD=psalmony-local
COOKIE_SECURE=false
# Outside Docker only:
DATABASE_URL=postgres://psalmony:psalmony-local@127.0.0.1:54329/psalmony
# Optional Jamulus pilot (compose.rehearsal.yaml). Local-only by default.
JAMULUS_BIND_IP=127.0.0.1
JAMULUS_CLIENT_ADDRESS=127.0.0.1:22124
JAMULUS_LOCATION=Екатеринбург
# Alternative: remote audio host (compose.rehearsal.remote.yaml).
# JAMULUS_REMOTE_HOST=audio.example.com
# JAMULUS_REMOTE_PORT=22124
# JAMULUS_REMOTE_LOCATION=Москва

# Optional own audio engine; generate with: openssl rand -hex 32
AUDIO_TICKET_SECRET=
